# --- Security (required in production) ---------------------------------------
# Signs the anonymous identity cookie. >= 32 random chars: openssl rand -base64 48
SESSION_SECRET=change-me
# Optional: previous secret, still accepted for verification during rotation.
# SESSION_SECRET_PREVIOUS=
# Number of reverse proxies in front of `node server.mjs` that APPEND to X-Forwarded-For.
# 0 = exposed directly (forwarded headers from clients are ignored).
TRUST_PROXY_HOPS=0
# Alternatively, a platform's trusted client-IP header (e.g. cf-connecting-ip). Leave unset otherwise.
# CLIENT_IP_HEADER=
# Bearer token for detailed / deep health checks (>= 16 chars). Unset = public { ok: true } only.
# HEALTH_TOKEN=
# Refuse new uploads when free disk would drop below this many bytes (default 1 GiB).
# MIN_FREE_BYTES=1073741824

# --- Database (optional) -----------------------------------------------------
# Neon Postgres. Leave unset for the zero-config JSON store. Prefer a least-privilege
# login IN ROLE hoopload_app (see SECURITY.md); use the owner role only for migrations.
# DATABASE_URL=postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# --- Storage -----------------------------------------------------------------
UPLOAD_DIR=./.data

# --- SEO ---------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
